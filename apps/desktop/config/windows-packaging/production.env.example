# Copy to production.env in the same machine configuration directory and fill in the values.
DSH_DESKTOP_APP_ID=com.fiwen.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=production
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://api.5wn.net
# The backend's update-required link points at the public download origin, so the
# fallback-page allowlist must include https://desktop.5wn.net.
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedPageOrigins":["https://desktop.5wn.net"]}'
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
