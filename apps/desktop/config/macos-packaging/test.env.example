# Copy to test.env; paths in secret configuration resolve beside macos-signing.env.
DSH_DESKTOP_APP_ID=com.fiwen.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
DOWNLOAD_TEST_ORIGIN=
# Generate a 32-character lowercase hexadecimal release ID; retain it for upgrade testing.
DOWNLOAD_TEST_RELEASE_ID=
# Backend API origin for the bundled runtime. Set the test API origin for
# test-channel packages; omitting it leaves the runtime on the production default.
# FIWEN_ORIGIN=https://<test-backend-origin>
# FIWEN_DASH_ORIGIN=https://<test-dashboard-origin>
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Temporarily changes the active network service's system HTTP/HTTPS proxies.
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# DSH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
