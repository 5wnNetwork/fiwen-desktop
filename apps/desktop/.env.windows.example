# Copy to .env.windows (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Credential file paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.fiwen.desktop
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
# Generate once per release batch; retain it for retries and versions testing upgrades within that batch.
DOWNLOAD_TEST_RELEASE_ID=

# API origin used by the bundled runtime: account platform, inference, web tools,
# marketplace, and telemetry all derive from it. This is the production default;
# a test-channel build must set its test API origin here instead.
FIWEN_ORIGIN=https://api.5wn.net
# Dashboard origin serving browser sign-in and the embedded Usage/Top-up pages.
FIWEN_DASH_ORIGIN=https://dash.5wn.net

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com


# The selected mandatory-update origin is required, including unsigned and preparation builds.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://api.5wn.net
# Set approved login origins for test builds; omit allowedAuthOrigins for production.
# Optional polling and fallback-page options belong in the same JSON value.
# The fallback-page allowlist defaults to the selected service origin.
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional absolute, private local directory; defaults to %USERPROFILE%\.dsh-desktop-signing\signature-cache\v1.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=C:\Users\build\.dsh-desktop-signing\signature-cache\v1

# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Optional S3-compatible upload configuration (Wasabi or any S3 API); packaging does not require these credentials.
# DOWNLOAD_TEST_S3_BUCKET=
# DOWNLOAD_TEST_S3_ENDPOINT=https://s3.<region>.wasabisys.com
# DOWNLOAD_TEST_S3_REGION=<region>
# DOWNLOAD_TEST_S3_ACCESS_KEY_ID=
# DOWNLOAD_TEST_S3_SECRET_ACCESS_KEY=
# DOWNLOAD_PROD_S3_BUCKET=
# DOWNLOAD_PROD_S3_ENDPOINT=https://s3.<region>.wasabisys.com
# DOWNLOAD_PROD_S3_REGION=<region>
# DOWNLOAD_PROD_S3_ACCESS_KEY_ID=
# DOWNLOAD_PROD_S3_SECRET_ACCESS_KEY=
